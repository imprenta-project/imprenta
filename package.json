{
  "name": "imprenta",
  "private": true,
  "description": "Document engine in Rust with React authoring. PDF first; XLSX and DOCX to follow.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/imprenta-project/imprenta.git"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean",
    "ci": "turbo run test build lint format:check check-types",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish --tag next"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "turbo": "2.10.8",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  }
}
