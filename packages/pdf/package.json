{
  "name": "@imprentajs/pdf",
  "version": "0.1.0-alpha.3",
  "description": "Imprenta's PDF engine: measure, paginate, paint. One WebAssembly module, every runtime.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/imprenta-project/imprenta.git",
    "directory": "packages/pdf"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "imprenta-pdf.wasm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "clean": "rm -rf dist imprenta-pdf.wasm"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "default": "./dist/stream.js"
    },
    "./imprenta-pdf.wasm": "./imprenta-pdf.wasm",
    "./engine": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./shard": {
      "types": "./dist/shard.d.ts",
      "default": "./dist/shard.js"
    }
  },
  "type": "module"
}
