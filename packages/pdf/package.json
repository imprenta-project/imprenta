{
  "name": "@imprentajs/pdf",
  "version": "0.0.0",
  "description": "Imprenta's PDF engine, as a native Node addon.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/imprenta-project/imprenta.git",
    "directory": "packages/pdf"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "dist"
  ],
  "napi": {
    "binaryName": "imprenta",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --manifest-path ../../crates/imprenta-pdf-napi/Cargo.toml --output-dir . && tsc -p tsconfig.build.json",
    "build:debug": "napi build --platform --manifest-path ../../crates/imprenta-pdf-napi/Cargo.toml --output-dir . && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "clean": "rm -rf *.node index.js index.d.ts"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.8.2",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "default": "./dist/stream.js"
    }
  }
}
