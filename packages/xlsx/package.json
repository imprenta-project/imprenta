{
  "name": "@imprentajs/xlsx",
  "version": "0.1.0-alpha.1",
  "description": "Imprenta's spreadsheet writer. One WebAssembly module, every runtime.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/imprenta-project/imprenta.git",
    "directory": "packages/xlsx"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "imprenta-xlsx.wasm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "clean": "rm -rf dist imprenta-xlsx.wasm"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@imprentajs/pdf": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "default": "./dist/stream.js"
    },
    "./imprenta-xlsx.wasm": "./imprenta-xlsx.wasm",
    "./writer": {
      "types": "./dist/writer.d.ts",
      "default": "./dist/writer.js"
    }
  },
  "type": "module"
}
