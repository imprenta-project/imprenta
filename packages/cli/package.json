{
  "name": "@imprentajs/cli",
  "version": "0.1.0-alpha.2",
  "description": "Preview and build Imprenta documents.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/imprenta-project/imprenta.git",
    "directory": "packages/cli"
  },
  "bin": {
    "imprenta": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "app/dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "dev": "node dist/bin.js dev",
    "dev:app": "vite"
  },
  "dependencies": {
    "@imprentajs/fonts": "workspace:*",
    "@imprentajs/pdf": "workspace:*",
    "@imprentajs/react": "workspace:*",
    "@imprentajs/xlsx": "workspace:*",
    "esbuild": "0.28.1",
    "vite": "8.2.0"
  },
  "peerDependencies": {
    "react": ">=19.2.0"
  },
  "devDependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/spectral": "5.3.0",
    "@headless-tree/core": "1.7.0",
    "@headless-tree/react": "1.7.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "happy-dom": "20.11.1",
    "lucide-react": "1.28.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "4.16.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
