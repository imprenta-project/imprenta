{
  "name": "@imprentajs/react",
  "version": "0.1.0-alpha.0",
  "description": "Declare an Imprenta document in React.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/imprenta-project/imprenta.git",
    "directory": "packages/react"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./pdf": {
      "types": "./dist/pdf/index.d.ts",
      "import": "./dist/pdf/index.js",
      "require": "./dist/pdf/index.cjs"
    },
    "./xlsx": {
      "types": "./dist/xlsx/index.d.ts",
      "import": "./dist/xlsx/index.js",
      "require": "./dist/xlsx/index.cjs"
    },
    "./any": {
      "types": "./dist/any.d.ts",
      "import": "./dist/any.js",
      "require": "./dist/any.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/pdf/index.ts src/xlsx/index.ts src/any.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=19.2.0"
  },
  "dependencies": {
    "react-reconciler": "0.33.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-reconciler": "0.28.9",
    "react": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@imprentajs/pdf": "workspace:*",
    "@imprentajs/xlsx": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  },
  "module": "./dist/index.js"
}
