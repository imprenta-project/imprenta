# Exact versions, always. A caret is a promise that a stranger's minor release
# will not change what this repository builds, and that promise is not theirs
# to make: the engine is a compiled artefact and a lockfile is not enough on
# its own — `pnpm add` writing `^1.2.3` is how a range gets in in the first
# place. Upgrades happen because somebody chose one, in a commit that says so.
save-exact=true
